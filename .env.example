# Copie para .env e defina valores proprios. O arquivo .env nao e versionado.
# Variaveis lidas pelo docker-compose.yml.

POSTGRES_USER=equilog
POSTGRES_PASSWORD=defina-uma-senha
POSTGRES_DB=equilog

# Portas expostas no hospedeiro
PORTA_BANCO=5432
PORTA_HTTPS=3443
PORTA_HTTP=3080

# Segredos de assinatura JWT (RFC 7519). Gere valores longos e aleatorios,
# por exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SEGREDO_ACESSO=defina-um-segredo-aleatorio
JWT_SEGREDO_RENOVACAO=defina-outro-segredo-aleatorio
