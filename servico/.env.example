# Copie para servico/.env para usar o Prisma e o Jest fora do conteiner.
# O arquivo .env nao e versionado. Usuario, senha e banco devem coincidir com o
# .env da raiz do repositorio. Use 127.0.0.1, e nao localhost (ver README).

DATABASE_URL=postgresql://equilog:defina-uma-senha@127.0.0.1:5432/equilog?schema=public

# Banco exclusivo da suite de testes, recriado a cada execucao
DATABASE_URL_TESTE=postgresql://equilog:defina-uma-senha@127.0.0.1:5432/equilog_teste?schema=public

JWT_SEGREDO_ACESSO=defina-um-segredo-aleatorio
JWT_SEGREDO_RENOVACAO=defina-outro-segredo-aleatorio
